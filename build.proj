<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    </PropertyGroup>
    <ItemGroup>
        <SubprojectsToBuild Include="$(MSBuildThisFileDirectory)gr_starttiledata\gr_starttiledata.slnx">
            <Properties>Configuration=$(Configuration);Platform=x64</Properties>
        </SubprojectsToBuild>
        <SubprojectsToBuild Include="$(MSBuildThisFileDirectory)gr_starttiledata\gr_starttiledata.slnx">
            <Properties>Configuration=$(Configuration);Platform=ARM64</Properties>
        </SubprojectsToBuild>

        <BaseProjectsToBuild Include="$(MSBuildThisFileDirectory)GR-Taskbar.sln">
            <Properties>Configuration=$(Configuration);Platform=amd64</Properties>
        </BaseProjectsToBuild>
        <BaseProjectsToBuild Include="$(MSBuildThisFileDirectory)GR-Taskbar.sln">
            <Properties>Configuration=$(Configuration);Platform=arm64;WithArm64XBinaries=true</Properties>
        </BaseProjectsToBuild>
    </ItemGroup>
    <Target Name="ValidateSources">
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)gr_starttiledata\gr_starttiledata.slnx')" Text="Missing required StartTileData solution in repository root." />
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)GR-Taskbar.sln')" Text="Missing GR-Taskbar.sln in repository root." />
    </Target>
    <Target Name="Build" DependsOnTargets="ValidateSources">
        <MSBuild Projects="@(SubprojectsToBuild)" BuildInParallel="true" />
        <MSBuild Projects="$(MSBuildThisFileDirectory)GR-Taskbar.sln" Properties="Configuration=$(Configuration);Platform=IA-32" />
        <MSBuild Projects="@(BaseProjectsToBuild)" BuildInParallel="true" />
    </Target>
    <Target Name="BuildSigned" DependsOnTargets="ValidateSources">
        <Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="powershell.exe -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\Build-GRTaskbar.ps1&quot; -SigningMode SelfSigned" />
    </Target>
</Project>
